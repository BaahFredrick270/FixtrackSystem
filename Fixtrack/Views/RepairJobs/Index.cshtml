@using Fixtrack.Models
@model IEnumerable<Fixtrack.Models.RepairJob>

@{
    ViewData["Title"] = "Repair Jobs";
    var statusCounts = ViewBag.StatusCounts as Dictionary<RepairStatus, int> ?? new();
    var selectedStatus = ViewBag.SelectedStatus as RepairStatus?;
    var totalCount = statusCounts.Values.Sum();
    var isReceptionist = User.IsInRole("Receptionist");

    string BadgeClass(RepairStatus status) => status switch
    {
        RepairStatus.Received => "text-bg-secondary",
        RepairStatus.Assigned => "text-bg-info",
        RepairStatus.Diagnosing => "text-bg-info",
        RepairStatus.AwaitingApproval => "text-bg-primary",
        RepairStatus.Repairing => "text-bg-warning",
        RepairStatus.AwaitingParts => "text-bg-warning",
        RepairStatus.ReadyForPickup => "text-bg-success",
        RepairStatus.Completed => "text-bg-success",
        RepairStatus.Cancelled => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}

@if (TempData["Status"] != null)
{
    <div class="alert alert-success">@TempData["Status"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">Repair Jobs</h1>

    @if (isReceptionist)
    {
        <a asp-action="Create" class="btn btn-primary">New Repair Job</a>
    }
</div>

<!-- Filter chips -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index"
       class="btn btn-sm @(selectedStatus == null ? "btn-primary" : "btn-outline-secondary")">
        All (@totalCount)
    </a>

    @foreach (RepairStatus status in Enum.GetValues<RepairStatus>())
    {
        var count = statusCounts.TryGetValue(status, out var c) ? c : 0;
        <a asp-action="Index" asp-route-status="@status"
           class="btn btn-sm @(selectedStatus == status ? "btn-primary" : "btn-outline-secondary")">
            @status.ToString() (@count)
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card empty-state text-center py-5">
        <div class="card-body">
            @if (isReceptionist)
            {
                <p class="text-muted mb-3">No repair jobs found.</p>
                <a asp-action="Create" class="btn btn-primary">Open the first repair job</a>
            }
            else
            {
                <p class="text-muted mb-0">No repair jobs assigned to you yet.</p>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="ft-thead">
                    <tr>
                        <th>Job #</th>
                        <th>Customer</th>
                        <th>Device</th>
                        <th>Technician</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td>@job.JobNumber</td>
                            <td>@(job.Customer?.FullName ?? "—")</td>
                            <td>@(job.Device?.DisplayName ?? "—")</td>
                            <td>@(job.Technician?.User?.FullName ?? "Unassigned")</td>
                            <td><span class="badge @BadgeClass(job.Status)">@job.Status</span></td>
                            <td>@job.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@job.Id"
                                   class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}