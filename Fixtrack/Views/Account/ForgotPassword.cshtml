@using Fixtrack.ViewModels
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<a asp-controller="Account" asp-action="Login" class="auth-back" aria-label="Back to log in">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"/></svg>
    <span>Back</span>
</a>

<div class="auth-card">
    <div class="text-center mb-3">
        <h1 class="fw-bold mb-2">Forgot password?</h1>
        <p class="text-muted mb-0">Enter your email and we'll send you a reset link.</p>
    </div>

    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label fw-semibold">Your account email</label>
            <input asp-for="Email" class="form-control form-control-lg"
                   autocomplete="email" autofocus placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
            <div class="form-text">We'll send the reset link to this address.</div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Send reset link</button>

        <div class="text-center mt-3">
            <a asp-controller="Account" asp-action="Login" class="small text-decoration-none">Back to log in</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
