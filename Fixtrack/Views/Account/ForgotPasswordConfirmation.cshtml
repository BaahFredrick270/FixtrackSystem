@{
    ViewData["Title"] = "Check your email";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card text-center">
    <h1 class="fw-bold mb-2">Check your email</h1>
    <p class="text-muted">If an account exists for that address, a reset link is on its way. It can take a minute, and it may land in spam.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg w-100 mt-2">Back to log in</a>
</div>
