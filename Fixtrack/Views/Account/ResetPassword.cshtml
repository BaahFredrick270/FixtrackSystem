@using Fixtrack.ViewModels
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<a asp-controller="Account" asp-action="Login" class="auth-back" aria-label="Back to log in">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"/></svg>
    <span>Back</span>
</a>

<div class="auth-card">
    <div class="text-center mb-3">
        <h1 class="fw-bold mb-2">Choose a new password</h1>
    </div>

    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold">New password</label>
            <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" autofocus />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm new password</label>
            <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Reset password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
