@{
    ViewData["Title"] = "Password updated";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card text-center">
    <h1 class="fw-bold mb-2">Password updated</h1>
    <p class="text-muted">You can now log in with your new password.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg w-100 mt-2">Log in</a>
</div>
