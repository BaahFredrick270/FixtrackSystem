@*
    Reusable password visibility toggle.
    Used by both Login and Register pages.
*@
<button class="btn btn-outline-secondary password-toggle"
        type="button"
        data-toggle-password
        tabindex="-1"
        aria-pressed="false"
        aria-label="Show password"
        title="Show password">

    <!-- Password hidden -->
    <svg class="icon-eye"
         xmlns="http://www.w3.org/2000/svg"
         width="18"
         height="18"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="1.8"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">

        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />

        <circle cx="12"
                cy="12"
                r="3" />
    </svg>


    <!-- Password visible -->
    <svg class="icon-eye-off"
         xmlns="http://www.w3.org/2000/svg"
         width="18"
         height="18"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="1.8"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true"
         hidden>

        <path d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6.4 0 10 7 10 7a18 18 0 0 1-2.8 3.7" />

        <path d="M6.6 6.7A18 18 0 0 0 2 13s3.6 7 10 7a9.6 9.6 0 0 0 5.4-1.6" />

        <path d="M9.9 10.1a3 3 0 0 0 4.2 4.2" />

        <path d="m3 3 18 18" />

    </svg>

</button>