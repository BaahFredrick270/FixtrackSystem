@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string NavState(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script>
            (function() {
                try {
                    var saved = localStorage.getItem("ft-theme");
                    var theme = saved ||
                        (window.matchMedia("(prefers-color-scheme: dark)").matches
                            ? "dark"
                            : "light");

                    document.documentElement.setAttribute("data-bs-theme", theme);
                } catch (e) {
                    document.documentElement.setAttribute("data-bs-theme", "light");
                }
            })();
    </script>

    <title>@ViewData["Title"] - FixTrack</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Fixtrack.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- =========================
         TOP BAR
         ========================= -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm ft-navbar border-bottom shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">FT</span>
                    <span>FixTrack</span>
                </a>

                @if (!isAuthenticated)
                {
                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div id="mainNavbar" class="navbar-collapse collapse">
                        <ul class="navbar-nav flex-grow-1" id="landingNav">
                            <li class="nav-item">
                                @if (currentController == "Home")
                                {
                                    <a class="nav-link" href="#home">Home</a>
                                }
                                else
                                {
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                                }
                            </li>
                            <li class="nav-item"><a class="nav-link" href="#services">Services</a></li>
                            <li class="nav-item"><a class="nav-link" href="#how-it-works">How It Works</a></li>
                            <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                        </ul>

                        <div class="d-flex align-items-center gap-2">
                            <partial name="_ThemeToggle" />
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <partial name="_ThemeToggle" />
                        <partial name="_NotificationBell" />
                        <partial name="_LoginPartial" />
                    </div>
                }

            </div>
        </nav>
    </header>


    <!-- =========================
         BODY: SIDEBAR + CONTENT
         ========================= -->
    @if (isAuthenticated)
    {
        <div class="app-shell">

            <nav class="app-sidebar" aria-label="Main navigation">

                <div class="flex-grow-1">
                    <a class="sidebar-link @NavState("Home")" asp-controller="Home" asp-action="Index">
                        <span>Dashboard</span>
                    </a>

                    @if (User.IsInRole("Receptionist"))
                    {
                        <a class="sidebar-link @NavState("Customers")" asp-controller="Customers" asp-action="Index">
                            <span>Customers</span>
                        </a>
                    }

                    <a class="sidebar-link @NavState("Devices")" asp-controller="Devices" asp-action="Index">
                        <span>Devices</span>
                    </a>
                    <a class="sidebar-link @NavState("RepairJobs")" asp-controller="RepairJobs" asp-action="Index">
                        <span>Repairs</span>
                    </a>

                    @if (User.IsInRole("Receptionist"))
                    {
                        <a class="sidebar-link @NavState("Technicians")" asp-controller="Technicians" asp-action="Index">
                            <span>Technicians</span>
                        </a>
                    }
                </div>

                <div class="sidebar-version">
                    FixTrack v1.0
                </div>

            </nav>

            <main class="app-content" role="main">
                @RenderBody()
            </main>

        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>

        <!-- =========================
             FOOTER (signed-out only)
             ========================= -->
        <footer class="footer border-top">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <span>&copy; 2026 FixTrack</span>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
        </footer>
    }


    <!-- =========================
         JAVASCRIPT
         ========================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>