@model IEnumerable<Fixtrack.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">Customers</h1>
    <a asp-action="Create" class="btn btn-primary">New Customer</a>
</div>

@if (!Model.Any())
{
    <div class="card empty-state text-center py-5">
        <div class="card-body">
            <p class="text-muted mb-3">No customers registered yet.</p>
            <a asp-action="Create" class="btn btn-primary">Register your first customer</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="ft-thead">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Location</th>
                        <th>Devices</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Id</td>
                            <td>@customer.FullName</td>
                            <td>@customer.PhoneNumber</td>
                            <td>@(customer.Address ?? "—")</td>
                            <td>@customer.Devices.Count</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@customer.Id"
                                   class="btn btn-sm btn-outline-secondary">View</a>
                                <a asp-action="Edit" asp-route-id="@customer.Id"
                                   class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@customer.Id"
                                   class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}