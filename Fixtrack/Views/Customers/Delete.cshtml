@model Fixtrack.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">Delete customer</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this customer?</strong>
    This action cannot be undone, and any devices or repair jobs tied to
    this customer may be affected.
</div>

<div class="card form-card">
    <div class="card-body p-4">

        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "—")</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@(Model.Address ?? "—")</dd>

            <dt class="col-sm-3">Registered On</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>

    </div>
</div>