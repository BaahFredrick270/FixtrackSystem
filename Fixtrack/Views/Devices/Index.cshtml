@model IEnumerable<Fixtrack.Models.Device>

@{
    ViewData["Title"] = "Devices";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">Devices</h1>
</div>

@if (!Model.Any())
{
    <div class="card empty-state text-center py-5">
        <div class="card-body">
            <p class="text-muted mb-0">No devices on record yet.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="ft-thead">
                    <tr>
                        <th>Type</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Owner</th>
                        <th>Serial Number</th>
                        <th>Added On</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in Model)
                    {
                        <tr>
                            <td>@device.DeviceType</td>
                            <td>@device.Brand</td>
                            <td>@device.Model</td>
                            <td>@(device.Customer?.FullName ?? "—")</td>
                            <td>@(device.SerialNumber ?? "—")</td>
                            <td>@device.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@device.Id"
                                   class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}