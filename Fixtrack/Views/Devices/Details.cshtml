@model Fixtrack.Models.Device

@{
    ViewData["Title"] = "Device Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">@Model.DisplayName</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <h2 class="h6 fw-bold text-muted text-uppercase mb-3">Device details</h2>

        <dl class="row mb-0">
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.DeviceType</dd>

            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@Model.Brand</dd>

            <dt class="col-sm-3">Model</dt>
            <dd class="col-sm-9">@Model.Model</dd>

            <dt class="col-sm-3">Serial Number</dt>
            <dd class="col-sm-9">@(Model.SerialNumber ?? "—")</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Condition))
            {
                <dt class="col-sm-3">Condition</dt>
                <dd class="col-sm-9">@Model.Condition</dd>
            }

            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">
                @if (Model.Customer == null)
                {
                    <span>—</span>
                }
                else if (User.IsInRole("Receptionist"))
                {
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.FullName</a>
                }
                else
                {
                    <span>@Model.Customer.FullName</span>
                }
            </dd>

            <dt class="col-sm-3">Added On</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <h2 class="h6 fw-bold text-muted text-uppercase mb-3">Repair history</h2>

        @if (!Model.RepairJobs.Any())
        {
            <p class="text-muted mb-0">No repair jobs recorded for this device yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="ft-thead">
                        <tr>
                            <th>Job #</th>
                            <th>Status</th>
                            <th>Technician</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.RepairJobs.OrderByDescending(j => j.CreatedAt))
                        {
                            <tr>
                                <td>@job.JobNumber</td>
                                <td>@job.Status</td>
                                <td>@(job.Technician?.User?.FullName ?? "Unassigned")</td>
                                <td>@job.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-controller="RepairJobs" asp-action="Details" asp-route-id="@job.Id"
                                       class="btn btn-sm btn-outline-secondary">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>