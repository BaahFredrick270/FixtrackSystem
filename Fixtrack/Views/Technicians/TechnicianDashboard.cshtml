```cshtml
@{
    ViewData["Title"] = "Technician Dashboard";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Technician Dashboard</h2>
        <p class="text-muted">
            Welcome back. Here is an overview of your repair jobs.
        </p>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Assigned Jobs
                    </small>

                    <h2 class="fw-bold mt-2">
                        5
                    </h2>

                    <a asp-action="RepairJobs"
                       class="btn btn-sm btn-outline-primary">
                        View Jobs
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        In Progress
                    </small>

                    <h2 class="fw-bold mt-2">
                        3
                    </h2>

                    <a asp-action="RepairJobs"
                       class="btn btn-sm btn-outline-warning">
                        View In Progress
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Completed
                    </small>

                    <h2 class="fw-bold mt-2">
                        12
                    </h2>

                    <a asp-action="RepairJobs"
                       class="btn btn-sm btn-outline-success">
                        View Completed
                    </a>
                </div>
            </div>
        </div>

    </div>


    <!-- Current Jobs -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h5 class="fw-bold mb-1">
                        Current Repair Jobs
                    </h5>

                    <p class="text-muted mb-0">
                        Repairs that require your attention.
                    </p>
                </div>

                <a asp-action="RepairJobs"
                   class="btn btn-primary btn-sm">
                    View All
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Job ID</th>
                            <th>Customer</th>
                            <th>Device</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>#JOB001</td>

                            <td>
                                Kwame Mensah
                            </td>

                            <td>
                                iPhone 13
                            </td>

                            <td>
                                <span class="badge bg-warning text-dark">
                                    In Progress
                                </span>
                            </td>

                            <td>
                                <a asp-action="RepairDetails"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                        </tr>

                        <tr>
                            <td>#JOB002</td>

                            <td>
                                Ama Boateng
                            </td>

                            <td>
                                HP Laptop
                            </td>

                            <td>
                                <span class="badge bg-info">
                                    Assigned
                                </span>
                            </td>

                            <td>
                                <a asp-action="RepairDetails"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
