@model Fixtrack.Models.Technician

@{
    ViewData["Title"] = "Edit Technician";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">Edit technician</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="card form-card mb-5">
    <div class="card-body p-4">
        <p class="mb-4"><strong>@Model.User?.FullName</strong> &middot; @Model.User?.Email</p>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Specialization" class="form-label"></label>
                    <select asp-for="Specialization" class="form-select"
                            asp-items="Html.GetEnumSelectList<Fixtrack.Models.Specialization>()"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select"
                            asp-items="Html.GetEnumSelectList<Fixtrack.Models.TechnicianStatus>()"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="BaseLocation" class="form-label"></label>
                    <input asp-for="BaseLocation" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>