@model Fixtrack.ViewModels.TechnicianRegistrationViewModel

@{
    ViewData["Title"] = "New Technician";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">Register a technician</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="card form-card mb-5">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email (login username)</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Specialization" class="form-label"></label>
                    <select asp-for="Specialization" class="form-select"
                            asp-items="Html.GetEnumSelectList<Fixtrack.Models.Specialization>()"></select>
                </div>

                <div class="col-md-6">
                    <label asp-for="BaseLocation" class="form-label"></label>
                    <input asp-for="BaseLocation" class="form-control" />
                </div>
            </div>

            <p class="text-muted small">
                A temporary password is generated automatically and shown once after you save.
            </p>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Register Technician</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}