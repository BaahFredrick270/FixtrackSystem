@model Fixtrack.ViewModels.TechnicianCredentialsViewModel

@{
    ViewData["Title"] = "Technician created";
}

<h1 class="h3 fw-bold mb-4">Technician registered</h1>

<div class="alert alert-warning">
    <strong>Copy these credentials now.</strong>
    The password is shown only once and cannot be retrieved later.
</div>

<div class="card form-card mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Username (email)</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Temporary password</dt>
            <dd class="col-sm-8"><code class="fs-5">@Model.TemporaryPassword</code></dd>
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-primary">Done</a>