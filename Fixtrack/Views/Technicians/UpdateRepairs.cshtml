```cshtml
@{
    ViewData["Title"] = "Update Repair";
}

<div class="container py-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Update Repair
        </h2>

        <p class="text-muted">
            Update the status and work performed on this repair.
        </p>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form method="post">

                <div class="mb-4">

                    <label class="form-label">
                        Repair Job
                    </label>

                    <input type="text"
                           class="form-control"
                           value="#JOB001 - iPhone 13"
                           readonly />

                </div>


                <div class="mb-4">

                    <label class="form-label">
                        Repair Status
                    </label>

                    <select name="Status"
                            class="form-select"
                            required>

                        <option>
                            Assigned
                        </option>

                        <option selected>
                            In Progress
                        </option>

                        <option>
                            Waiting for Parts
                        </option>

                        <option>
                            Completed
                        </option>

                        <option>
                            Cannot Repair
                        </option>

                    </select>

                </div>


                <div class="mb-4">

                    <label class="form-label">
                        Work Performed
                    </label>

                    <textarea name="WorkPerformed"
                              class="form-control"
                              rows="5"
                              placeholder="Describe the work you performed on the device..."></textarea>

                </div>


                <div class="mb-4">

                    <label class="form-label">
                        Technician Notes
                    </label>

                    <textarea name="TechnicianNotes"
                              class="form-control"
                              rows="4"
                              placeholder="Add any additional notes..."></textarea>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Update
                    </button>

                    <a asp-action="RepairDetails"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
```
