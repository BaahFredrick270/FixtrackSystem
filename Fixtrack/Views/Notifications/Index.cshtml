@model IEnumerable<Fixtrack.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var items = Model.OrderByDescending(n => n.CreatedAt).ToList();
    var unreadCount = items.Count(n => !n.IsRead);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">
        Notifications
        @if (unreadCount > 0)
        {
            <span class="badge text-bg-warning ms-2 fs-6">@unreadCount new</span>
        }
    </h1>

    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-secondary">Mark all as read</button>
        </form>
    }
</div>

@if (!items.Any())
{
    <div class="card empty-state text-center py-5">
        <div class="card-body">
            <p class="text-muted mb-0">You have no notifications yet.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var n in items)
            {
                <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center gap-3 py-3 @(n.IsRead ? "" : "border-start border-4 border-warning")">
                    <div>
                        <div class="@(n.IsRead ? "text-muted" : "fw-semibold")">@n.Message</div>
                        <div class="small text-muted">@n.CreatedAt.ToString("dd MMM yyyy, h:mm tt")</div>
                    </div>

                    @if (n.RepairJobId != null)
                    {
                        <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="flex-shrink-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Open job</button>
                        </form>
                    }
                    else if (!n.IsRead)
                    {
                        <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="flex-shrink-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}